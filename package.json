{
  "name": "@local/prompt-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prompt library manager: file-backed prompt sources with a sidebar management page and optional system-prompt injection.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-remotes"]
    }
  }
}
